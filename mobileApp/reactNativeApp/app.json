{
  "expo": {
    "name": "chatApp",
    "slug": "chatApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/chatApp.jpg",
    "scheme": "reactnativeapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/chatApp.jpg",
        "backgroundColor": "transparent"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.deepareshma.chatApp",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d8df7af-760b-4cb4-bdb8-a5d2655c26f1"
      }
    },
    "owner": "deepareshma"
  }
}
